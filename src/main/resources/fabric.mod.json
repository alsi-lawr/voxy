{
  "schemaVersion": 1,
  "id": "voxy",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "Voxy",
  "description": "Far distance rendering mod utilising LoDs",
  "authors": [
    "Cortex"
  ],
  "contact": {
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/voxy/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.cortex.voxy.client.VoxyClient"
    ],
    "modmenu": [
      "me.cortex.voxy.client.config.ModMenuIntegration"
    ],
    "main": [
      "me.cortex.voxy.commonImpl.VoxyCommon"
    ]
  },
  "mixins": [
    {
      "config": "client.voxy.mixins.json",
      "environment": "client"
    },
    "common.voxy.mixins.json"
  ],
  "depends": {
    "minecraft": "${allowed_mc_version}",
    "java": ">=17",
    "fabricloader": ">=0.18.4",
    "fabric-api": ">=0.92.8",
    "sodium": "${allowed_sodium_versions}"
  },
  "breaks": {
    "iris": ["<1.7.6", ">1.7.6"],
    "voxyworldgenv2": "=2.2.2"
  },
  "accessWidener": "voxy.accesswidener"
}
